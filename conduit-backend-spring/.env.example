# Copy to .env (never commit .env). Spring reads real environment variables;
# export them or use your IDE / `set -a; source .env; set +a`.
PORT=8080

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=conduit_dev
DATABASE_USER=dev_user
DATABASE_PASSWORD=dev_pass

# REQUIRED. At least 32 characters; the app refuses to start otherwise.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
JWT_TTL_MINUTES=720

CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
